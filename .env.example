# Password for the badge desk. Change this before a real event.
ADMIN_PASSWORD=badge-desk

# Supabase transaction pooler. Copy it from Project Settings → Database → Connection string.
# Use the pooler host (port 6543), not the direct db host. The app uses this to store scans.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Project URL and secret key from Project Settings → API. Server only. Do not commit the real secret.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
